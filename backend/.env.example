# Namecheap Private Email — order confirmations from orders@kindard.com
# Add MX + SPF + DKIM on the DNS host that actually serves kindard.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=orders@kindard.com
SMTP_PASS=
MAIL_FROM="Kindard Orders <orders@kindard.com>"
MAIL_REPLY_TO=orders@kindard.com
